<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Suite" parallel="tests" thread-count="2">
	<test name="chromeTest" parallel="classes" thread-count="4">
		<parameter name="browser" value="chrome"></parameter>
		<classes>
			<class name="factorial.Validation_UIElements" />
			<class name="factorial.ValidationsPartTwo" />
			<class name="factorial.FactorialCheck" />
			<class name="factorial.AboutPage_LinkCheck" />
			<class name="factorial.NegativeValidations" />
			<class name="factorial.BoundaryValueAnalysis" />
			<class name="factorial.TermsAndPrivacy_LinkCheck" />
		</classes>
	</test>
	<test name="firefoxTest" parallel="classes" thread-count="4">
		<parameter name="browser" value="firefox"></parameter>
		<classes>
			<class name="factorial.Validation_UIElements" />
			<class name="factorial.ValidationsPartTwo" />
			<class name="factorial.FactorialCheck" />
			<class name="factorial.AboutPage_LinkCheck" />
			<class name="factorial.NegativeValidations" />
			<class name="factorial.BoundaryValueAnalysis" />
			<class name="factorial.TermsAndPrivacy_LinkCheck" />
		</classes>
	</test> <!--
	Test -->
</suite> <!--
Suite -->
